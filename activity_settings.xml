<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="16dp">


        <!-- CPU -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Main CPU Sensor"
            android:textSize="18sp"
            android:textStyle="bold"/>


        <Spinner
            android:id="@+id/spCPU"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"/>


        <!-- GPU -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Main GPU Sensor"
            android:textSize="18sp"
            android:textStyle="bold"

            android:layout_marginTop="16dp"/>


        <Spinner
            android:id="@+id/spGPU"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"/>


        <!-- Additional Sensors -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Sensors to monitor"

            android:textSize="18sp"
            android:textStyle="bold"

            android:layout_marginTop="24dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Select only the sensors you need. Unselected sensors will not be processed or recorded."

            android:textSize="14sp"

            android:layout_marginTop="4dp"/>


        <LinearLayout

            android:id="@+id/sensorContainer"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:layout_marginTop="8dp"/>


        <!-- Battery -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Battery"

            android:textSize="18sp"
            android:textStyle="bold"

            android:layout_marginTop="24dp"/>


        <CheckBox
            android:id="@+id/chkBatteryPercentage"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Battery percentage"/>


        <!-- Save -->

        <Button
            android:id="@+id/btnSave"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="SAVE"

            android:layout_marginTop="24dp"/>


    </LinearLayout>

</ScrollView>


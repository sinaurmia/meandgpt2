<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <Space
            android:layout_width="42dp"
            android:layout_height="match_parent"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Monitor"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⋮"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"/>

    </LinearLayout>


    <!-- Refresh Rate -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_refresh">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Refresh Rate"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spRefresh"
            android:layout_width="230dp"
            android:layout_height="42dp"/>

    </LinearLayout>


    <!-- Main content -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">


            <!-- CPU -->

            <LinearLayout
                android:id="@+id/cardCPU"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_temperature_card"
                android:elevation="3dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:id="@+id/txtCPU"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="--&#10;CPU"
                    android:textColor="?android:attr/textColorPrimary"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="18dp"
                    android:background="@color/light_border"
                    android:alpha="0.65"/>

                <TextView
                    android:id="@+id/txtCPUStats"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="MAX   --&#10;MIN   --&#10;AVG   --"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- GPU -->

            <LinearLayout
                android:id="@+id/cardGPU"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_temperature_card"
                android:elevation="3dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:id="@+id/txtGPU"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="--&#10;GPU"
                    android:textColor="?android:attr/textColorPrimary"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="18dp"
                    android:background="@color/light_border"
                    android:alpha="0.65"/>

                <TextView
                    android:id="@+id/txtGPUStats"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="MAX   --&#10;MIN   --&#10;AVG   --"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- Battery -->

            <LinearLayout
                android:id="@+id/cardBattery"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_temperature_card"
                android:elevation="3dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:id="@+id/txtBattery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="--&#10;Battery"
                    android:textColor="?android:attr/textColorPrimary"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="18dp"
                    android:background="@color/light_border"
                    android:alpha="0.65"/>

                <TextView
                    android:id="@+id/txtBatteryStats"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="MAX   --&#10;MIN   --&#10;AVG   --"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- Additional sensors -->

            <TableLayout
                android:id="@+id/txtSensors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:stretchColumns="0"/>

        </LinearLayout>

    </ScrollView>


    <!-- Bottom Navigation -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_bottom_navigation"
        android:elevation="6dp">

        <Button
            android:id="@+id/btnMonitoring"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="●&#10;MONITORING"
            android:textColor="@color/primary_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnRecording"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="○&#10;RECORD"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"/>

    </LinearLayout>

</LinearLayout>